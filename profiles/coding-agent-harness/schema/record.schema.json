  "required": [
    "profile",
    "profile_version",
    "kind",
    "id",
    "title",
    "status",
    "observed_at",
    "environment",
    "capabilities",
    "components",
    "capability_links",
    "constraints",
    "evidence",
    "evaluations",
    "evaluation_evidence",
    "observations",
    "incidents",
    "procedures",
    "changes",
    "verifications"
  ],
  "additionalProperties": true,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "observed"
          }
        }
      },
      "then": {
        "properties": {
          "observed_at": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "environment": {
            "type": "object",
            "properties": {
              "runtime": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "version": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "minLength": 1,
                    "maxLength": 256
                  },
                  "provider": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "minLength": 1,
                    "maxLength": 256
                  }
                },
                "required": [
                  "name",
                  "version",
                  "provider"
                ],
                "additionalProperties": true
              }
            },
            "required": [
              "runtime"
            ],
            "additionalProperties": true
          }
        }
      }
    }
